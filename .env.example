# Copiar a .env (cp .env.example .env). El .env nunca se sube al repo.
# docker compose lo lee automáticamente; si no existe, se usan los valores por defecto
# de docker-compose.yml, que coinciden con estos. Aquí no hay valores reales: los de
# staging y producción viven en SSM Parameter Store.

APP_ENV=local
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
MEDIA_BUCKET=es-b2-media-891377256343
MEDIA_BASE_URL=/media
AWS_REGION=eu-west-1
SECRET_KEY=cambiar-en-local
CORS_ORIGINS=http://localhost:5173

# Feature flags: FEATURE_<NOMBRE>=true|false. Todas las que pongáis aquí llegan a la API.
# FEATURE_EJEMPLO=false
