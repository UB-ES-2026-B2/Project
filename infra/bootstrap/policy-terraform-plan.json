{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::es-b2-tfstate-891377256343"
    },
    {
      "Sid": "StateRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::es-b2-tfstate-891377256343/*"
    },
    {
      "Sid": "LockFile",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::es-b2-tfstate-891377256343/*.tflock"
    },
    {
      "Sid": "DenyAppData",
      "Effect": "Deny",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::es-b2-media-891377256343/*",
        "arn:aws:s3:::es-b2-backups-891377256343/*"
      ]
    },
    {
      "Sid": "DenySecrets",
      "Effect": "Deny",
      "Action": ["secretsmanager:GetSecretValue", "kms:Decrypt"],
      "Resource": "*"
    }
  ]
}
